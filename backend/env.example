# Copy this file to ".env" and fill it in. NEVER commit ".env" to git.

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local testing (a file on your computer):
DATABASE_URL=sqlite:///./styleme.db

# AWS RDS Database for PostgreSQL (replace the CAPITALS; special characters in the
# password must be URL-encoded, e.g. @ becomes %40):
# DATABASE_URL=postgresql+psycopg2://USERNAME:PASSWORD@styleme-db.c52gicmwkwo1.ap-southeast-2.rds.amazonaws.com:5432/styleme?sslmode=require


# Which websites may call this backend. "*" is fine while developing.
# Later set it to your real site, e.g. https://yourname.github.io
ALLOWED_ORIGINS=*

# Gemini API Key for AI functionality
#GEMINI_API_KEY=change me