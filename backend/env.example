# Copy this file to ".env" and fill it in. NEVER commit ".env" to git.

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Local testing (a file on your computer, no Azure needed):
DATABASE_URL=sqlite:///./styleme.db

# Azure Database for PostgreSQL (replace the CAPITALS; special characters in the
# password must be URL-encoded, e.g. @ becomes %40):
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@YOURSERVER.postgres.database.azure.com:5432/styleme?sslmode=require

# Azure SQL Database:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@YOURSERVER.database.windows.net:1433/styleme?driver=ODBC+Driver+18+for+SQL+Server

# Which websites may call this backend. "*" is fine while developing.
# Later set it to your real site, e.g. https://yourname.github.io
ALLOWED_ORIGINS=*
